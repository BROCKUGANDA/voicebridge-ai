generator client {
  provider     = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences     UserPreferences?
  conversations   Conversation[]
  sessions        VoiceSession[]
  interactions    InteractionHistory[]
  visualAnalyses  VisualAnalysis[]
}

model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  voiceSpeed       Float   @default(1.0)
  voicePitch       Float   @default(1.0)
  voiceVolume      Float   @default(0.8)
  selectedVoice    String  @default("default")
  responseVerbosity String  @default("balanced")
  voiceEnginePref   String  @default("auto")
  autoRecoverPrimary Boolean @default(true)
  soundTheme       String  @default("minimal")
  soundVolume      Float   @default(0.5)
  hapticFeedback   Boolean @default(true)
  autoDescribe     Boolean @default(true)
  fontSize         String  @default("medium")
  highContrast     Boolean @default(true)
  reducedMotion    Boolean @default(false)
  keyboardShortcuts Boolean @default(true)
  spatialAudio     Boolean @default(false)
  pronunciationOverrides String @default("{}")
  customCommands       String @default("{}")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  title     String   @default("New Conversation")
  context   String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     VoiceSession?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  messages    ConversationMessage[]

  @@index([userId])
  @@index([sessionId])
}

model ConversationMessage {
  id           String   @id @default(cuid())
  conversationId String
  role         String
  content      String
  confidence   Float?
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model VoiceSession {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("active")
  duration        Int      @default(0)
  commandCount    Int      @default(0)
  errorCount      Int      @default(0)
  successCount    Int      @default(0)
  startedAt       DateTime @default(now())
  endedAt         DateTime?

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  interactions  InteractionHistory[]
  visualAnalyses VisualAnalysis[]
  metrics       AccessibilityMetric[]

  @@index([userId])
  @@index([status])
}

model InteractionHistory {
  id              String   @id @default(cuid())
  userId          String
  sessionId       String?
  type            String
  command         String
  response        String
  success         Boolean  @default(true)
  responseTimeMs  Int?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session VoiceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
}

model VisualAnalysis {
  id            String   @id @default(cuid())
  userId        String?
  sessionId     String?
  elementType   String
  description   String
  confidence    Float
  boundingBox   String   @default("{}")
  accessibilityAttributes String @default("{}")
  createdAt     DateTime @default(now())

  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session VoiceSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
}

model AccessibilityMetric {
  id              String   @id @default(cuid())
  sessionId       String?
  taskCompletionRate  Float?
  avgCommandsPerTask  Float?
  errorRate       Float?
  userSatisfaction Float?
  independenceScore Float?
  cognitiveLoadScore Float?
  recordedAt      DateTime @default(now())

  session VoiceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([recordedAt])
}

/// Security audit trail. Written fire-and-forget by lib/security.ts audit();
/// read by /api/auth/audit (admin). Retention is pruned opportunistically.
model AuditEvent {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  action    String
  detail    String   @default("")
  userId    String?
  ip        String   @default("0.0.0.0")
  ua        String   @default("")
  ok        Boolean  @default(true)

  @@index([ts])
  @@index([action])
  @@index([userId])
}